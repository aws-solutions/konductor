    {
      "name": "toolsSettings_non_alphabetical_key_order_preserved",
      "_source_note": "Regression fixture for the Rust/Python JSON key-ordering divergence (serde_json::Value defaulting to a BTreeMap, which silently alphabetizes object keys, vs. Python dict/json.load preserving source insertion order). Keys are deliberately out of alphabetical order (zebra, apple, middle) so an equality-only check (which is order-insensitive for JSON objects) would not catch a regression -- see kiro_cli.rs's transform_preserves_non_alphabetical_tools_settings_key_order for the order-sensitive assertion this fixture case backs.",
      "raw_input": "{\"schemaVersion\":\"1\",\"name\":\"k-example\",\"config\":{\"description\":\"d\",\"systemPrompt\":\"s\",\"model\":\"m\"},\"clientConfig\":{\"kiroCli\":{\"tools\":[\"@builtin\"],\"toolsSettings\":{\"zebra\":1,\"apple\":2,\"middle\":3}}}}",
      "expected": {
        "ok": {
          "name": "k-example",
          "config": { "description": "d", "system_prompt": "s", "model": "m" },
          "dependencies": { "context_names": [], "agent_sop_names": [], "mcp_registry_keys": [] },
          "kiro_cli_tools": ["@builtin"],
          "kiro_cli_allowed_tools": [],
          "kiro_cli_tools_settings": { "zebra": 1, "apple": 2, "middle": 3 },
          "claude_cli_skills": null
        }
      }
    },
