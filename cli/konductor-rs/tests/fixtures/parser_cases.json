    {
      "name": "valid_v1_spec",
      "raw_input": "{\"schemaVersion\":\"1\",\"name\":\"k-example\",\"config\":{\"description\":\"Example agent.\",\"model\":\"claude-sonnet-5\",\"systemPrompt\":\"You are an example agent.\"},\"dependencies\":{\"skills\":{},\"context\":{\"contextNames\":[\"routing.md\"]},\"mcpRegistry\":{\"example-mcp\":{\"command\":\"uvx\",\"args\":[\"example-mcp@latest\"]}},\"agentSops\":{\"agentSopNames\":[\"example-sop\"]}},\"clientConfig\":{\"kiroCli\":{\"tools\":[\"@builtin\"],\"allowedTools\":[\"fs_read\"],\"resources\":[\"file://AGENTS.md\"]},\"claudeCli\":{\"tools\":[\"Read\"],\"skills\":[\"constraints\"]}}}",
      "expected": {
        "ok": {
          "name": "k-example",
          "config": {
            "description": "Example agent.",
            "system_prompt": "You are an example agent.",
            "model": "claude-sonnet-5"
          },
          "dependencies": {
            "context_names": ["routing.md"],
            "agent_sop_names": ["example-sop"],
            "mcp_registry_keys": ["example-mcp"]
          },
          "kiro_cli_tools": ["@builtin"],
          "kiro_cli_allowed_tools": ["fs_read"],
          "claude_cli_tools": ["Read"],
          "claude_cli_skills": ["constraints"]
        }
      }
    },
