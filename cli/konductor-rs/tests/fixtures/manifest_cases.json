      "files": [],
      "expected": {
        "serialized": "{\n  \"schema_version\": 1,\n  \"strategy\": \"kiro-cli\",\n  \"installed_at\": \"2026-01-15T09:30:00Z\",\n  \"destination\": \".\",\n  \"source\": null,\n  \"status\": \"complete\",\n  \"files\": []\n}\n"
