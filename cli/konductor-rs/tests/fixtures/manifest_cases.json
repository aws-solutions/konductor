    {
      "name": "single_agent_file",
      "strategy": "kiro-cli",
      "installed_at": "2026-01-15T09:30:00Z",
      "destination": ".",
      "status": "complete",
      "files": [
        {"path": ".kiro/agents/k-example.json", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "provenance": "created"}
      ],
      "expected": {
        "serialized": "{\n  \"schema_version\": 1,\n  \"strategy\": \"kiro-cli\",\n  \"installed_at\": \"2026-01-15T09:30:00Z\",\n  \"destination\": \".\",\n  \"source\": null,\n  \"status\": \"complete\",\n  \"files\": [\n    {\n      \"path\": \".kiro/agents/k-example.json\",\n      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n      \"provenance\": \"created\"\n    }\n  ]\n}\n"
      }
