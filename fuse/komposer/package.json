{
  "name": "fuse-komposer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Komposer: edit fuse-flow workflows in all three locations and view their runs. A local server (server/) serves the app and the files of one project.",
  "license": "Apache-2.0",
  "scripts": {
    "start": "bun server/main.ts",
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun test server test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
