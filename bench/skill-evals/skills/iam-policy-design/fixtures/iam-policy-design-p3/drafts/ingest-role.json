{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IngestPresign",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::docintake-uploads-111122223333/incoming/*"
    },
    {
      "Sid": "IngestJobs",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:us-east-1:111122223333:table/DocIntakeJobs"
    },
    {
      "Sid": "IngestKms",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/0b1c2d3e-4f50-6172-8394-a5b6c7d8e9f0"
    }
  ]
}
