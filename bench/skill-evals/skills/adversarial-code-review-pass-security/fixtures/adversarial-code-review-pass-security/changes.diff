diff --git a/src/routes/reset.js b/src/routes/reset.js
--- /dev/null
+++ b/src/routes/reset.js
@@ -0,0 +1,28 @@
+'use strict';
+
+const express = require('express');
+const crypto = require('crypto');
+const db = require('../db');
+const logger = require('../logger');
+const { sendMail } = require('../mailer');
+
+const router = express.Router();
+const MAILER_API_KEY = 'mk_live_51HxQ2eZvKYlo2C8a9f3Jd0Q';
+
+router.post('/password-reset', async (req, res) => {
+  logger.info('password reset requested', { headers: req.headers, body: req.body });
+  try {
+    const rows = await db.query(`SELECT id, email FROM users WHERE email = '${req.body.email}'`);
+    if (rows.length === 0) return res.status(404).json({ error: `no user with email ${req.body.email}` });
+    const user = rows[0];
+    const token = crypto.randomBytes(32).toString('hex');
+    await db.query('UPDATE users SET reset_token = ? WHERE id = ?', [token, user.id]);
+    await db.query('INSERT INTO audit_log (user_id, action) VALUES (?, ?)', [user.id, 'password_reset']);
+    await sendMail(MAILER_API_KEY, user.email, token);
+    return res.json({ ok: true });
+  } catch (err) {
+    return res.status(500).json({ error: err.message, stack: err.stack });
+  }
+});
+
+module.exports = router;
