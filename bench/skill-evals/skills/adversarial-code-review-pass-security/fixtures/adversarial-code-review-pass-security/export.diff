diff --git a/src/routes/export.js b/src/routes/export.js
--- /dev/null
+++ b/src/routes/export.js
@@ -0,0 +1,14 @@
+'use strict';
+
+const express = require('express');
+const db = require('../db');
+
+const router = express.Router();
+
+router.get('/admin/export', async (req, res) => {
+  const { offset } = JSON.parse(Buffer.from(String(req.query.next || 'eyJvZmZzZXQiOjB9'), 'base64').toString());
+  const rows = await db.query(`SELECT id, email, plan FROM users ORDER BY id LIMIT 500 OFFSET ${offset}`);
+  res.json({ rows, next: Buffer.from(JSON.stringify({ offset: offset + 500 })).toString('base64') });
+});
+
+module.exports = router;
