diff --git a/test/export.test.js b/test/export.test.js
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,13 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { execSync } = require('child_process');
+
+const FAKE_SESSION = 'test-session-0000';
+
+test('export returns rows', () => {
+  const host = process.env.TEST_HOST;
+  const out = execSync(`curl -s -H "authorization: ${FAKE_SESSION}" http://${host}/admin/export`).toString();
+  assert.ok(JSON.parse(out).rows);
+});
