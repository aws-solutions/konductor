diff --git a/src/services/transfer.js b/src/services/transfer.js
new file mode 100644
--- /dev/null
+++ b/src/services/transfer.js
@@ -0,0 +1,29 @@
+const { UpdateCommand } = require('@aws-sdk/lib-dynamodb');
+const { docClient } = require('../lib/ddb');
+
+const TABLE = process.env.ACCOUNTS_TABLE;
+
+async function transferFunds(fromId, toId, amount) {
+  await docClient.send(
+    new UpdateCommand({
+      TableName: TABLE,
+      Key: { accountId: fromId },
+      UpdateExpression: 'SET balance = balance - :amt',
+      ConditionExpression: 'balance >= :amt',
+      ExpressionAttributeValues: { ':amt': amount },
+    }),
+  );
+
+  await docClient.send(
+    new UpdateCommand({
+      TableName: TABLE,
+      Key: { accountId: toId },
+      UpdateExpression: 'SET balance = balance + :amt',
+      ExpressionAttributeValues: { ':amt': amount },
+    }),
+  );
+
+  return { fromId, toId, amount };
+}
+
+module.exports = { transferFunds };
diff --git a/src/repo/orderRepo.js b/src/repo/orderRepo.js
new file mode 100644
--- /dev/null
+++ b/src/repo/orderRepo.js
@@ -0,0 +1,30 @@
+const { GetCommand, PutCommand } = require('@aws-sdk/lib-dynamodb');
+const { randomUUID } = require('crypto');
+const { docClient } = require('../lib/ddb');
+
+const ORDERS = process.env.ORDERS_TABLE;
+const AUDIT = process.env.AUDIT_TABLE;
+
+async function updateOrderStatus(orderId, status) {
+  const { Item: order } = await docClient.send(
+    new GetCommand({ TableName: ORDERS, Key: { orderId } }),
+  );
+  const updated = { ...order, status, version: order.version + 1 };
+  await docClient.send(new PutCommand({ TableName: ORDERS, Item: updated }));
+  const { Item: fresh } = await docClient.send(
+    new GetCommand({ TableName: ORDERS, Key: { orderId } }),
+  );
+  return fresh;
+}
+
+async function appendAudit(orderId, event) {
+  await docClient.send(
+    new PutCommand({
+      TableName: AUDIT,
+      Item: { auditId: randomUUID(), orderId, event, at: Date.now() },
+      ConditionExpression: 'attribute_not_exists(auditId)',
+    }),
+  );
+}
+
+module.exports = { updateOrderStatus, appendAudit };
diff --git a/src/workers/applyCredit.js b/src/workers/applyCredit.js
new file mode 100644
--- /dev/null
+++ b/src/workers/applyCredit.js
@@ -0,0 +1,19 @@
+const { UpdateCommand } = require('@aws-sdk/lib-dynamodb');
+const { docClient } = require('../lib/ddb');
+
+const TABLE = process.env.ACCOUNTS_TABLE;
+
+// SQS-triggered Lambda. Failed messages are redelivered by SQS (maxReceiveCount 5).
+exports.handler = async (event) => {
+  for (const record of event.Records) {
+    const { accountId, amount } = JSON.parse(record.body);
+    await docClient.send(
+      new UpdateCommand({
+        TableName: TABLE,
+        Key: { accountId },
+        UpdateExpression: 'ADD balance :amt',
+        ExpressionAttributeValues: { ':amt': amount },
+      }),
+    );
+  }
+};
diff --git a/test/setup.js b/test/setup.js
new file mode 100644
--- /dev/null
+++ b/test/setup.js
@@ -0,0 +1,18 @@
+const { BatchWriteCommand } = require('@aws-sdk/lib-dynamodb');
+const { docClient } = require('../src/lib/ddb');
+
+// Seeds fixture accounts before each integration test run.
+async function seedAccounts() {
+  await docClient.send(
+    new BatchWriteCommand({
+      RequestItems: {
+        [process.env.ACCOUNTS_TABLE]: [
+          { PutRequest: { Item: { accountId: 'acct-1', balance: 1000 } } },
+          { PutRequest: { Item: { accountId: 'acct-2', balance: 0 } } },
+        ],
+      },
+    }),
+  );
+}
+
+module.exports = { seedAccounts };
