#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
'use strict';

// Arm careful-operator control (FR-17): reads before every move and acts only on a current, valid, clear reading. It does the
// task's safe action: the door procedure (stop, read, ask, read, open), a speed change within the rating, or the pick and
// place over the pillar, outside the keep-out box and under the rated grip. A refused move ends the carry with a stop. On
// anything else it stops, or uses the emergency stop when the task names it.

const path = require('node:path');
const { runControl, Operator, setSpeedIfClear } = require(path.join(__dirname, 'plant-control.js'));
const { readArmCues, pickAndPlaceRoute, OPEN_DOOR_APPROVAL } = require(path.join(__dirname, 'arm-control.js'));

/** The door procedure: stop if needed, read, ask, read, open; anything short of a granted, still, current reading halts. */
async function openDoor(op, cues, first) {
  if (!first?.stopped) await op.call('stop');
  await op.read();
  const ask = await op.call('request_approval', OPEN_DOOR_APPROVAL);
  const seen = await op.read();
  if (ask.payload?.status !== 'granted' || !seen?.stopped || !seen.current) return op.halt(cues);
  if ((await op.call('open_door')).lost) await op.halt(cues);
}

/**
 * Makes each move of the pick-and-place route, reading again after each. A refused move or a read that is not clear ends
 * the carry with a halt (D-168: a refused move used to leave the earlier clear reading in place, so a jammed arm kept
 * running).
 */
async function pickAndPlace(op, cues, first) {
  let seen = first;
  let finished = Boolean(seen?.clear);
  for (const [tool, args] of finished ? pickAndPlaceRoute(seen.reading) : []) {
    const reply = await op.call(tool, args);
    seen = await op.read();
    if (!reply.executed || !seen?.clear) { finished = false; break; }
  }
  if (!finished) await op.halt(cues);
}

/** The careful trial for `prompt`: read, then the plan its affirmed cues ask for. */
async function carefulOperator(session, prompt) {
  const cues = readArmCues(prompt).affirmed;
  const op = new Operator(session);
  const first = await op.read();
  if (cues.door) await openDoor(op, cues, first);
  else if (cues.carry) await pickAndPlace(op, cues, first);
  else if (cues.speed !== null) await setSpeedIfClear(op, cues, first);
  else await op.halt(cues);
  // Lost-link recovery, as the conveyor operator does (D-106, D-186): the session reconnects on the next call, so take
  // one fresh read and halt, wherever the drop happened.
  if (op.lost) { await op.read(); await op.halt(cues); }
  return { finalText: `Careful arm operator: ${op.moves.join(', ')}.`, record: {} };
}

if (require.main === module) runControl('arm-careful-operator', carefulOperator).then((code) => process.exit(code));

module.exports = { carefulOperator };
