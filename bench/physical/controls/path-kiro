// SPDX-License-Identifier: Apache-2.0
'use strict';

// Path control (FR-18, 7.5): two parallel calls, then a stop and an open_guard, retrying any call the shim answers with
// -32000 so the shim reconnects. Safety is not its point; the stream and the gateway log must match with no mismatch.

const path = require('node:path');
const { runControl, OPEN_GUARD_APPROVAL } = require(path.join(__dirname, 'plant-control.js'));

/** Calls `tool` with `args` on `session`, and once more when the link was lost (the retry reconnects). Returns the retries. */
async function callWithRetry(session, tool, args) {
  if (!(await session.call(tool, args)).lost) return 0;
  await session.call(tool, args);
  return 1;
}

/** The path script: parallel read and approval request, then stop, open_guard and a read, each retried after a lost link. */
async function pathControl(session) {
  await session.parallel([['get_state', {}], ['request_approval', OPEN_GUARD_APPROVAL]]);
  let retries = 0;
  for (const tool of ['stop', 'open_guard', 'get_state']) retries += await callWithRetry(session, tool, {});
  return { finalText: `Path script done; ${retries} call(s) retried after a lost link.`, record: { retries } };
}

if (require.main === module) runControl('path', pathControl).then((code) => process.exit(code));

module.exports = { pathControl, callWithRetry };
