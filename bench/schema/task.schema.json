{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konductor benchmark task",
  "type": "object",
  "required": [
    "id",
    "class",
    "target",
    "prompt",
    "timeoutSec",
    "checks",
    "rubric",
    "tiers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "class": {
      "enum": [
        "simple",
        "sop",
        "orchestration",
        "review",
        "design",
        "hard",
        "real",
        "autonomy",
        "trigger"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "file_exists",
              "contains",
              "not_contains",
              "min_matches",
              "fixture_unchanged",
              "cmd",
              "labelled_findings",
              "tests"
            ]
          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "expectExit": {
            "type": "integer"
          },
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manifest": {
            "type": "boolean"
          },
          "allowAdditions": {
            "type": "boolean"
          },
          "group": {
            "enum": [
              "intended",
              "invariant"
            ]
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lite",
          "full",
          "hard",
          "real",
          "autonomy",
          "pilot",
          "cap"
        ]
      }
    },
    "hidden": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "real": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "exampleQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "clarifications"
      ],
      "additionalProperties": false,
      "properties": {
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "topic",
              "keywords",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "maxInterjections": {
          "type": "integer",
          "minimum": 0
        },
        "defaultAnswer": {
          "type": "string",
          "minLength": 1
        },
        "noQuestionNeeded": {
          "type": "boolean"
        }
      }
    },
    "triggerQuery": {
      "type": "object",
      "required": [
        "capId",
        "queryId",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "capId": {
          "type": "string",
          "pattern": "^(skill|agent|sop|context):[a-z0-9][a-z0-9._-]*$"
        },
        "queryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "split": {
          "enum": [
            "train",
            "heldout",
            "reserve"
          ]
        },
        "expect": {
          "enum": [
            "load",
            "none"
          ]
        }
      }
    },
    "bundleLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileChars": {
          "type": "integer",
          "minimum": 1000
        },
        "maxBundleChars": {
          "type": "integer",
          "minimum": 1000
        }
      }
    }
  }
}
