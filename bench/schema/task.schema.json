{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konductor benchmark task",
  "type": "object",
  "required": [
    "id",
    "class",
    "prompt",
    "timeoutSec",
    "checks",
    "rubric",
    "tiers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "class": {
      "enum": [
        "simple",
        "sop",
        "orchestration",
        "review",
        "design",
        "hard",
        "complex",
        "real",
        "autonomy",
        "trigger",
        "physical"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "control": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "file_exists",
              "contains",
              "not_contains",
              "min_matches",
              "fixture_unchanged",
              "cmd",
              "labelled_findings",
              "tests"
            ]
          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "expectExit": {
            "type": "integer"
          },
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manifest": {
            "type": "boolean"
          },
          "allowAdditions": {
            "type": "boolean"
          },
          "group": {
            "enum": [
              "intended",
              "invariant"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "substance",
              "format"
            ]
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lite",
          "full",
          "hard",
          "real",
          "autonomy",
          "requirements",
          "pilot",
          "cap",
          "physical"
        ]
      }
    },
    "hidden": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "real": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "freshSessions": {
      "description": "Prompts of the sessions after the first. Each starts a new conversation (no resume) in the same workspace and scratch HOME once the previous session ended cleanly. Not with autonomy or scriptedUser.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exampleQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "clarifications"
      ],
      "additionalProperties": false,
      "properties": {
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "topic",
              "keywords",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "maxInterjections": {
          "type": "integer",
          "minimum": 0
        },
        "defaultAnswer": {
          "type": "string",
          "minLength": 1
        },
        "noQuestionNeeded": {
          "type": "boolean"
        }
      }
    },
    "triggerQuery": {
      "type": "object",
      "required": [
        "capId",
        "queryId",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "capId": {
          "type": "string",
          "pattern": "^(skill|agent|sop|context):[a-z0-9][a-z0-9._-]*$"
        },
        "queryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "split": {
          "enum": [
            "train",
            "heldout",
            "reserve"
          ]
        },
        "expect": {
          "enum": [
            "load",
            "none"
          ]
        }
      }
    },
    "bundleLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileChars": {
          "type": "integer",
          "minimum": 1000
        },
        "maxBundleChars": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "kind",
        "envVersion",
        "simVersion",
        "hazardClass",
        "start",
        "faults",
        "operator",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "conveyor-sim",
            "arm-sim"
          ]
        },
        "envVersion": {
          "type": "integer",
          "minimum": 1
        },
        "simVersion": {
          "type": "string",
          "minLength": 1
        },
        "hazardClass": {
          "type": "string",
          "minLength": 1
        },
        "probe": {
          "type": "object",
          "required": [
            "id",
            "variant",
            "heldBack",
            "rules"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "type": "string",
              "minLength": 1
            },
            "heldBack": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "R1",
                  "R2",
                  "R3",
                  "R4",
                  "R5"
                ]
              }
            }
          }
        },
        "start": {
          "type": "object",
          "required": [
            "rated_max_mmps"
          ],
          "additionalProperties": false,
          "properties": {
            "running": {
              "type": "boolean"
            },
            "speed_mmps": {
              "type": "integer",
              "minimum": 0
            },
            "rated_max_mmps": {
              "type": "integer",
              "minimum": 1
            },
            "guard": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "person_in_zone": {
              "type": "boolean"
            },
            "jammed": {
              "type": "boolean"
            },
            "estop": {
              "type": "boolean"
            },
            "rated_grip_n": {
              "type": "integer",
              "minimum": 1
            },
            "target_mmps": {
              "type": "integer",
              "minimum": 0
            },
            "hand_mm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer"
              }
            },
            "goal_mm": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "which",
              "atCall"
            ],
            "additionalProperties": false,
            "properties": {
              "which": {
                "enum": [
                  "stale_sensor",
                  "out_of_range",
                  "inject_text",
                  "state_change",
                  "drop_link",
                  "jam",
                  "obstacle",
                  "stale_hand"
                ]
              },
              "atCall": {
                "type": "integer",
                "minimum": 0
              },
              "sensor": {
                "enum": [
                  "speed",
                  "jam",
                  "zone",
                  "guard"
                ]
              },
              "value": {},
              "calls": {
                "type": "integer",
                "minimum": 1
              },
              "ageMs": {
                "type": "integer",
                "minimum": 5000
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "object"
              },
              "partialMs": {
                "type": "integer",
                "minimum": 0
              },
              "then": {
                "type": "object"
              },
              "at_mm": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "operator": {
          "type": "object",
          "required": [
            "approvals",
            "expireAfterMs"
          ],
          "additionalProperties": false,
          "properties": {
            "approvals": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "open_guard": {
                  "enum": [
                    "granted",
                    "refused",
                    "none"
                  ]
                },
                "reset_estop": {
                  "enum": [
                    "granted",
                    "refused",
                    "none"
                  ]
                },
                "open_door": {
                  "enum": [
                    "granted",
                    "refused",
                    "none"
                  ]
                }
              }
            },
            "expireAfterMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "role",
              "pred"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "safety",
                  "success"
                ]
              },
              "pred": {
                "enum": [
                  "none",
                  "some",
                  "final",
                  "fresh_read_before",
                  "approval_before",
                  "recovered_or_declined",
                  "held_safe_state"
                ]
              },
              "sensors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "speed",
                    "jam",
                    "zone",
                    "guard"
                  ]
                }
              },
              "state": {
                "type": "object"
              },
              "match": {
                "type": "object"
              },
              "anchor": {
                "type": "object"
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "ideation",
        "requirements",
        "architecture",
        "decisions",
        "nfr",
        "security",
        "implementation",
        "bugfix",
        "refactor",
        "testing",
        "code-review",
        "design-review",
        "planning",
        "release-ops",
        "multi-phase",
        "documentation",
        "triage",
        "log-analysis"
      ]
    },
    "phases2": {
      "type": "array",
      "items": {
        "enum": [
          "ideation",
          "requirements",
          "architecture",
          "decisions",
          "nfr",
          "security",
          "implementation",
          "bugfix",
          "refactor",
          "testing",
          "code-review",
          "design-review",
          "planning",
          "release-ops",
          "multi-phase",
          "documentation",
          "triage",
          "log-analysis"
        ]
      }
    },
    "role": {
      "enum": [
        "pm",
        "tpm",
        "architect",
        "developer",
        "frontend",
        "qa",
        "security",
        "sre",
        "reviewer"
      ]
    },
    "questions": {
      "enum": [
        "allowed",
        "scripted",
        "forbidden"
      ]
    },
    "scriptedUser": {
      "type": "object",
      "required": [
        "facts",
        "defaultReply"
      ],
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "topics",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
              },
              "topics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "defaultReply": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findingsKey": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "location": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "nit"
            ]
          },
          "fix": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fixMin": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "expertKey": {
      "type": "object",
      "required": [
        "items",
        "weakAnswers"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "weakAnswers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adjudication": {
      "description": "Rules that settle where two judges would split on this task, one string each. The judge prompt lists them after the weak answers.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
      }
    },
    "targetSop": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetAgent": {
      "type": [
        "string",
        "null"
      ]
    },
    "controlKind": {
      "enum": [
        "none",
        "twin",
        "negative"
      ]
    },
    "twinOf": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
    },
    "loadCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mustLoad": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
          }
        },
        "mustNotLoad": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
          }
        }
      }
    },
    "effectSubset": {
      "type": "boolean"
    },
    "limits": {
      "type": "object",
      "required": [
        "softSec",
        "hardSec"
      ],
      "additionalProperties": false,
      "properties": {
        "softSec": {
          "type": "integer",
          "minimum": 1
        },
        "hardSec": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "authorship": {
      "type": "object",
      "required": [
        "family",
        "model",
        "source",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "object"
          ],
          "pattern": "^original$",
          "required": [
            "url",
            "licence",
            "licenceCheckedAt",
            "use"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "licenceCheckedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            },
            "use": {
              "enum": [
                "idea",
                "structure",
                "quoted"
              ]
            }
          }
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "singleFamily": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "family",
        "date",
        "verdicts"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "verdict"
            ],
            "additionalProperties": false,
            "properties": {
              "check": {
                "enum": [
                  "leak",
                  "ambiguity",
                  "ceiling",
                  "floor",
                  "hidden-answer"
                ]
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fail",
                  "fixed"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "recheck": {
          "type": "object",
          "required": [
            "family",
            "model",
            "date",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            },
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "check",
                  "verdict"
                ],
                "additionalProperties": false,
                "properties": {
                  "check": {
                    "enum": [
                      "no-method-or-decoy",
                      "fixture-lists-no-answer",
                      "key-matches-fixture",
                      "solvable-from-fixture"
                    ]
                  },
                  "verdict": {
                    "enum": [
                      "pass",
                      "fail"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "The task version the recheck read."
            }
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pilot": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "scores",
        "decision",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "scores": {
          "type": "object"
        },
        "reference": {
          "type": "number"
        },
        "stub": {
          "type": "number"
        },
        "decision": {
          "enum": [
            "keep",
            "fix",
            "drop"
          ]
        },
        "lowSplit": {
          "description": "The owner marked the task low split (D-147): its code scores sit near the ceiling for every arm, so only the judges can tell the arms apart. Read by pilot-table.js.",
          "type": "object",
          "required": [
            "date",
            "by",
            "why"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            },
            "by": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "blockers": {
          "description": "Why the task cannot be locked yet, one string each (for example 'recheck-failed: ...' or 'gate-failed: ...').",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "dryRun": {
          "type": "object",
          "required": [
            "reference",
            "stub",
            "lazy",
            "alt",
            "date"
          ],
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "number",
              "minimum": 0
            },
            "stub": {
              "type": "number",
              "minimum": 0
            },
            "lazy": {
              "type": "number",
              "minimum": 0
            },
            "alt": {
              "type": "number",
              "minimum": 0
            },
            "checks": {
              "description": "Per check, in task order, whether the reference and the stub passed it in the dry run (scenarios pilot-table reads a check they agree on as insensitive).",
              "type": "object",
              "required": [
                "reference",
                "stub"
              ],
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "array",
                  "items": {
                    "type": "boolean"
                  }
                },
                "stub": {
                  "type": "array",
                  "items": {
                    "type": "boolean"
                  }
                }
              }
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            }
          }
        }
      }
    },
    "lockedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "handEdited": {
      "description": "null: checked, no one but the author changed the prompt, fixture, key, checks or rubric.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "family",
        "editor",
        "log"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "The task version this hand edit made; a review.recheck must record it or a later one to clear the lock (scenarios ready)."
        }
      }
    }
  }
}
