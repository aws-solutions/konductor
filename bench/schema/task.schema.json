{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konductor benchmark task",
  "type": "object",
  "required": [
    "id",
    "class",
    "target",
    "prompt",
    "fixture",
    "timeoutSec",
    "checks",
    "rubric",
    "tiers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "class": {
      "enum": [
        "simple",
        "sop",
        "orchestration",
        "review",
        "design",
        "hard"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "file_exists",
              "contains",
              "not_contains",
              "min_matches",
              "fixture_unchanged",
              "cmd",
              "labelled_findings",
              "tests"
            ]
          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "expectExit": {
            "type": "integer"
          },
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lite",
          "full",
          "hard"
        ]
      }
    },
    "hidden": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    }
  }
}
