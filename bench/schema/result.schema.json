{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konductor benchmark run result",
  "type": "object",
  "required": [
    "armId",
    "ref",
    "commitSha",
    "harness",
    "model",
    "effort",
    "taskId",
    "replicate",
    "status",
    "exitCode",
    "runFinishedStatus",
    "wallClockMs",
    "turnDurationMs",
    "credits",
    "modelCalls",
    "toolCalls",
    "subagentCalls",
    "contextUsagePercentage",
    "transcriptBytes",
    "estTokens",
    "checks",
    "kiroCliVersion",
    "modelListSnapshotPath"
  ],
  "additionalProperties": false,
  "properties": {
    "throttleRetries": {
      "description": "Attempts the model service refused (a throttle) before this run, each kept as <replicate>.throttled-N with its own attempt-result.json (orchestrate.js DEFAULT_THROTTLE_RETRY).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dir", "status", "charged"],
        "additionalProperties": false,
        "properties": {
          "dir": { "type": "string" },
          "status": { "type": "string" },
          "error": { "type": ["string", "null"] },
          "charged": { "type": "number" }
        }
      }
    },
    "resumedFrom": {
      "description": "Under --resume, the folder name (<replicate>.resumed-N) the earlier unfinished, never-run or errored attempt of this cell was kept in before the rerun (orchestrate.js moveAside).",
      "type": "string",
      "pattern": "^\\d+\\.resumed-\\d+$"
    },
    "armId": {
      "type": "string"
    },
    "armLabel": {
      "type": "string"
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "commitSha": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness": {
      "enum": [
        "kiro-cli",
        "opencode",
        "claude-code",
        "strands"
      ]
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "replicate": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "success",
        "timeout",
        "error",
        "budget_skipped"
      ]
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "runFinishedStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallClockMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "turnDurationMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "credits": {
      "type": [
        "number",
        "null"
      ]
    },
    "modelCalls": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "meteringEntries",
        "totalRequestCount"
      ],
      "properties": {
        "meteringEntries": {
          "type": "integer"
        },
        "totalRequestCount": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "toolCalls": {
      "type": [
        "integer",
        "null"
      ]
    },
    "subagentCalls": {
      "type": [
        "integer",
        "null"
      ]
    },
    "orch": {
      "type": [
        "object",
        "null"
      ],
      "description": "Spawns, spawn depth, review rounds, reworks after a pass and phase documents read from the stream and the workspace (runner/lib/orch-metrics.js)."
    },
    "claudeCode": {
      "type": [
        "object",
        "null"
      ],
      "description": "Claude Code runs only: canonical model, models seen, modelUsage keys, cost basis, hook events, permission denials, spawn counts (runner/lib/harness/claude-code.js). skillListing is the same record as the top-level skillListing; the 2x2 kit's gate reads it here."
    },
    "skillListing": {
      "type": [
        "object",
        "null"
      ],
      "description": "The skill listing this arm's runs get, measured once per arm before any run (runner/lib/harness/claude-listing.js for Claude Code, kiro.js skillListingOf for Kiro CLI): harness, budgetChars, budgetSource, listingChars, skillsSent, overBudget, konductorDescribed, konductorNameOnly, nameOnly (the count of konductor skills sent by name only), otherDescribed, otherNameOnly, builtins, sops, sopsModelInvocable. Null when it could not be measured (run-config.json arms[].skillListingError says why)."
    },
    "unscrubbedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string" },
          "detail": { "type": "string" }
        }
      },
      "description": "Present when the flag credsUnscrubbed is set: output files (relative to the run directory) the credential scrub could not process. reason is the cause class (link: a link or non-regular file stood where a plain file was listed; unreadable: opening it for reading was refused; unwritable: it could not be rewritten; too-large: a secret-like run longer than the scrub window; error: anything else); detail is the error code or message. A run with this flag is not judged. Runs written before reason became a class carry free text there."
    },
    "tamperedFiles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Present when the flag stdioTampered is set: names of the live output files (stream, stderr) the agent replaced with a symlink, hardlink, special file or foreign file. They were not moved; an empty file stands in. The run also has infraError and is not judged."
    },
    "usageUnavailableReason": {
      "type": "string",
      "description": "Present when the flag usageUnavailable is set (opencode runs): a short fixed reason the post-run usage query did not produce numbers, with no host paths. The flag usageDbTampered is set when the reason is a link or non-regular file the agent planted where the database should be, and the run is not judged."
    },
    "armConfig": {
      "type": [
        "object",
        "null"
      ],
      "description": "Keys written to the arm scratch ~/.konductor/config.yml (--arm-config)."
    },
    "contextUsagePercentage": {
      "type": [
        "number",
        "null"
      ]
    },
    "transcriptBytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "estTokens": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "isEstimate"
      ],
      "properties": {
        "value": {
          "type": "integer"
        },
        "isEstimate": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "passed"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "min": {
            "type": "integer"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "object",
            "required": [
              "passed",
              "total"
            ],
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "unparsed": {
                "type": "boolean"
              }
            }
          },
          "regression": {
            "type": "object",
            "required": [
              "passed",
              "total"
            ],
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "allowAdditions": {
            "type": "boolean"
          },
          "manifest": {
            "type": "boolean"
          },
          "group": {
            "enum": [
              "intended",
              "invariant"
            ]
          }
        }
      }
    },
    "kiroCliVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelListSnapshotPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "streamModel": {
      "type": "string",
      "description": "The model the session's model setting held in the event stream (engine v3), when it was not auto. A configured value, not proof of which model served each request."
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentEngine": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "creditsCensored": {
      "type": "boolean"
    },
    "creditsLowerBound": {
      "type": [
        "number",
        "null"
      ]
    },
    "creditsCharged": {
      "type": [
        "number",
        "null"
      ]
    },
    "creditsSessionTotal": {
      "type": [
        "number",
        "null"
      ]
    },
    "creditLimit": {
      "type": [
        "number",
        "null"
      ]
    },
    "creditOvershoot": {
      "type": [
        "number",
        "null"
      ]
    },
    "workToolCalls": {
      "type": [
        "integer",
        "null"
      ]
    },
    "toolNames": {
      "type": [
        "object",
        "null"
      ]
    },
    "transcriptPartial": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "finalText": {
      "type": [
        "string",
        "null"
      ]
    },
    "finalTextTruncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "askedUser": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "skillsMcpOk": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "modelNormalized": {
      "type": "boolean"
    },
    "rewrittenAgents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mcpSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "isolation": {
      "type": [
        "string",
        "null"
      ]
    },
    "homeTripwireHits": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "inFlightAtStart": {
      "type": [
        "integer",
        "null"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infraError": {
      "type": [
        "string",
        "null"
      ]
    },
    "authFailure": {
      "type": [
        "string",
        "null"
      ]
    },
    "launchFailure": {
      "type": [
        "string",
        "null"
      ]
    },
    "installHarness": {
      "type": [
        "string",
        "null"
      ]
    },
    "harnessVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "input",
        "output",
        "reasoning",
        "cacheRead",
        "cacheWrite",
        "total"
      ],
      "description": "Token counts. A kiro-cli run has them only when kiro-cli reports them on the turn; a count it never reports is null, never 0.",
      "properties": {
        "input": {
          "type": ["integer", "null"]
        },
        "output": {
          "type": ["integer", "null"]
        },
        "reasoning": {
          "type": ["integer", "null"]
        },
        "cacheRead": {
          "type": ["integer", "null"]
        },
        "cacheWrite": {
          "type": ["integer", "null"]
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "costUsd": {
      "type": [
        "number",
        "null"
      ]
    },
    "costCensored": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "costUsdCharged": {
      "type": [
        "number",
        "null"
      ]
    },
    "sessionsRolledUp": {
      "type": [
        "integer",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "runStartedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "skillsLoaded": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "via",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "via": {
            "enum": [
              "get_skill",
              "skill-tool",
              "disclose_context",
              "read-skill-md",
              "shell-read-skill-md"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "skillQueries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "sopsLoaded": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "via",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "via": {
            "enum": [
              "get_skill",
              "skill-tool",
              "disclose_context",
              "read-skill-md",
              "shell-read-skill-md"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "skillBytesLoaded": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skillsLoadedFull": {
      "description": "Skills whose whole text reached the model at least once: a load answered with kiro-cli's cut preview is left out.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "via",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "via": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "skillLoads": {
      "description": "Every skill load in order, each with cut (the model got a preview or a slice) and whole (the full text reached the model, by this load or by later reads of the SKILL.md that cover it, then recovered is true).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "via",
          "cut",
          "whole"
        ],
        "properties": {
          "name": { "type": "string" },
          "via": { "type": "string" },
          "cut": { "type": "boolean" },
          "whole": { "type": "boolean" },
          "recovered": { "type": "boolean" },
          "sizeBytes": { "type": ["integer", "null"] },
          "bytes": { "type": "integer" }
        }
      }
    },
    "skillLoadsPreview": {
      "description": "Skill loads that delivered only kiro-cli's head-and-tail preview (answer over 30,000 characters).",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "skillsPreloaded": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "agents",
          "spawns"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "spawns": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "skillBytesPreloaded": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skillLoadsByScope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "main",
        "child"
      ],
      "properties": {
        "main": {
          "type": "integer",
          "minimum": 0
        },
        "child": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skillLoadsNoBody": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skillReferenceReads": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skillCallsFailed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skillCallsFailedByTool": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "get_skill",
        "load_resource",
        "find_skills"
      ],
      "properties": {
        "get_skill": {
          "type": "integer",
          "minimum": 0
        },
        "load_resource": {
          "type": "integer",
          "minimum": 0
        },
        "find_skills": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findSkillsCalls": {
      "type": [
        "integer",
        "null"
      ]
    },
    "findSkillsEmpty": {
      "type": [
        "integer",
        "null"
      ]
    },
    "startupResourceCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "targetLoaded": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "targetAttempted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "targetReachable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sopNameSource": {
      "enum": [
        "listing",
        "agent-filter",
        "convention",
        null
      ]
    },
    "skillsScope": {
      "enum": [
        "all-sessions",
        "parent-session",
        null
      ]
    },
    "loadCheck": {
      "type": [
        "object",
        "null"
      ],
      "description": "The load check (load-check.js): konductor units the run loaded with the stream index of their first load, and whether each unit the task needs (loadCheck.mustLoad, else its target skills and SOP) loaded before the first file write. Null for vanilla arms and runs saved before it existed.",
      "required": [
        "source",
        "firstWriteAt",
        "loaded",
        "mustLoad",
        "mustLoadBeforeWrite",
        "mustNotLoaded"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "loadCheck",
            "targets"
          ]
        },
        "firstWriteAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "loaded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit",
              "kind",
              "firstAt",
              "beforeFirstWrite"
            ],
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "skill",
                  "sop",
                  "agent"
                ]
              },
              "firstAt": {
                "type": "integer",
                "minimum": 0
              },
              "beforeFirstWrite": {
                "type": "boolean"
              }
            }
          }
        },
        "mustLoad": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit",
              "loaded",
              "beforeFirstWrite"
            ],
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "loaded": {
                "type": "boolean"
              },
              "beforeFirstWrite": {
                "type": "boolean"
              }
            }
          }
        },
        "mustLoadBeforeWrite": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mustNotLoaded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hiddenTests": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "passed",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unparsed": {
          "type": "boolean"
        }
      }
    },
    "regressionTests": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "passed",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contamination": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "externalFetch": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "externalFetchChecked": {
          "type": "boolean"
        },
        "fixRecallChars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "intendedTests": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "passed",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unparsed": {
          "type": "boolean"
        }
      }
    },
    "invariantTests": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "passed",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unparsed": {
          "type": "boolean"
        }
      }
    },
    "sessions": {
