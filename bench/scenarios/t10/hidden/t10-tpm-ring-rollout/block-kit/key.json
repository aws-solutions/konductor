{
  "outputFile": "docs/design/ring-aware-receipts.md",
  "items": [
    {
      "id": "declared-order",
      "type": "text",
      "path": "decisions",
      "all": [
        "staff.{0,100}pilot"
      ],
      "weight": 2
    },
    {
      "id": "serialized-state",
      "type": "text",
      "path": "decisions",
      "all": [
