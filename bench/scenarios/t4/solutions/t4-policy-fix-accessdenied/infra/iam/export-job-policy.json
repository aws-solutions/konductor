{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteExportObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:UploadPart"],
      "Resource": "arn:aws:s3:::nightly-exports-example/exports/*"
    },
    {
      "Sid": "ReadLedgerIndex",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": [
        "arn:aws:dynamodb:us-test-1:111122223333:table/LedgerRecords",
        "arn:aws:dynamodb:us-test-1:111122223333:table/LedgerRecords/index/by_day"
      ]
    },
    {
      "Sid": "UseExportKey",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "arn:aws:kms:us-test-1:111122223333:key/12345678-1234-4abc-8def-1234567890ab"
    }
  ]
}
