{
    "Statement": [
        {
            "Resource": "arn:aws:ecs:us-east-2:111122223333:service/operations/*",
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Effect": "Allow",
            "Sid": "ServiceOperations"
        },
        {
            "Resource": "*",
            "Action": [
                "cloudwatch:GetMetricData",
                "cloudwatch:GetMetricStatistics",
                "cloudwatch:ListMetrics"
            ],
            "Effect": "Allow",
            "Sid": "MetricsRead"
        },
        {
            "Resource": "*",
            "Action": [
                "iam:CreateAccessKey",
                "iam:CreateLoginProfile",
                "iam:UpdateLoginProfile",
                "organizations:*",
                "sts:*",
                "iam:*"
            ],
            "Effect": "Deny",
            "Sid": "RejectUserProvisioning"
        }
    ],
    "Version": "2012-10-17"
}
