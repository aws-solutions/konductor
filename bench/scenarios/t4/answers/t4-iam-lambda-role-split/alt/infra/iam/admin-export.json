{
    "Statement": [
        {
            "Resource": [
                "arn:aws:dynamodb:us-east-1:111122223333:table/staging-customers",
                "arn:aws:dynamodb:us-west-2:111122223333:table/prod-customers"
            ],
            "Action": "dynamodb:Scan",
            "Effect": "Allow"
        },
        {
            "Resource": [
                "arn:aws:s3:::lantern-staging-exports-111122223333/exports/*",
                "arn:aws:s3:::lantern-prod-exports-111122223333/exports/*"
            ],
            "Action": "s3:PutObject",
            "Effect": "Allow"
        },
        {
            "Resource": [
                "arn:aws:logs:us-east-1:111122223333:log-group:/aws/lambda/staging-admin-export:*",
                "arn:aws:logs:us-west-2:111122223333:log-group:/aws/lambda/prod-admin-export:*"
            ],
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Effect": "Allow"
        }
    ],
    "Version": "2012-10-17"
}
