{
    "Statement": [
        {
            "Resource": [
                "arn:aws:sqs:us-east-1:111122223333:staging-fulfilment",
                "arn:aws:sqs:us-west-2:111122223333:prod-fulfilment"
            ],
            "Action": [
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:ChangeMessageVisibility",
                "sqs:GetQueueAttributes"
            ],
            "Effect": "Allow"
        },
        {
            "Resource": [
                "arn:aws:sqs:us-east-1:111122223333:staging-fulfilment-dlq",
                "arn:aws:sqs:us-west-2:111122223333:prod-fulfilment-dlq"
            ],
            "Action": "sqs:SendMessage",
            "Effect": "Allow"
        },
        {
            "Resource": [
                "arn:aws:dynamodb:us-east-1:111122223333:table/staging-shipments",
                "arn:aws:dynamodb:us-west-2:111122223333:table/prod-shipments"
            ],
            "Action": "dynamodb:UpdateItem",
            "Effect": "Allow"
        },
        {
            "Resource": [
                "arn:aws:logs:us-east-1:111122223333:log-group:/aws/lambda/staging-fulfilment-worker:*",
                "arn:aws:logs:us-west-2:111122223333:log-group:/aws/lambda/prod-fulfilment-worker:*"
            ],
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Effect": "Allow"
        }
    ],
    "Version": "2012-10-17"
}
