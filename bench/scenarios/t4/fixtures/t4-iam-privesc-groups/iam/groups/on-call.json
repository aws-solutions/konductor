{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceOperations",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:us-east-2:111122223333:service/operations/*"
    },
    {
      "Sid": "MetricsRead",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData", "cloudwatch:GetMetricStatistics", "cloudwatch:ListMetrics"],
      "Resource": "*"
    },
    {
      "Sid": "UserProvisioning",
      "Effect": "Allow",
      "Action": ["iam:CreateAccessKey", "iam:CreateLoginProfile", "iam:UpdateLoginProfile"],
      "Resource": "arn:aws:iam::111122223333:user/*"
    }
  ]
}
