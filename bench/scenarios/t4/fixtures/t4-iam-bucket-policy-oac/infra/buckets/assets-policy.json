{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::assets-bucket-staging",
        "arn:aws:s3:::assets-bucket-staging/*",
        "arn:aws:s3:::assets-bucket-prod",
        "arn:aws:s3:::assets-bucket-prod/*"
      ]
    }
  ]
}