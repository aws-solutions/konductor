{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StaticSiteOperations",
      "Effect": "Allow",
      "Action": ["s3:*", "cloudfront:*", "lambda:*"],
      "Resource": "*"
    },
    {
      "Sid": "FunctionExecutionHandoff",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    },
    {
      "Sid": "LegacyOperations",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "*"
    }
  ]
}
