{
  "event_schema": {
    "name": "TelemetryEvent",
    "description": "Standard telemetry event for user sessions and API calls",
    "fields": [
      {
        "name": "event_id",
        "type": "string",
        "required": true,
        "description": "UUID v4, unique per event"
      },
      {
        "name": "timestamp",
        "type": "int64",
        "required": true,
        "description": "Unix epoch milliseconds"
      },
      {
        "name": "event_type",
        "type": "string",
        "required": true,
        "description": "session_start, api_call, metric, error"
      },
      {
        "name": "service_name",
        "type": "string",
        "required": true,
        "description": "Source microservice name"
      },
      {
        "name": "user_id",
        "type": "string",
        "required": false,
        "description": "Opaque user identifier"
      },
      {
        "name": "duration_ms",
        "type": "int32",
        "required": false,
        "description": "Event duration if applicable"
      },
      {
        "name": "status_code",
        "type": "int32",
        "required": false,
        "description": "HTTP status or error code"
      },
      {
        "name": "metadata",
        "type": "map<string, string>",
        "required": false,
        "description": "Additional key-value pairs"
      },
      {
        "name": "payload",
        "type": "bytes",
        "required": false,
        "description": "Optional binary payload"
      }
    ],
    "schema_evolution": {
      "backward_compatibility": "required",
      "forward_compatibility": "desired",
      "field_removal_policy": "deprecate_for_two_versions",
      "field_addition_policy": "optional_by_default"
    },
    "size_characteristics": {
      "typical_json_size_bytes": 1200,
      "min_json_size_bytes": 450,
      "max_json_size_bytes": 5000,
      "field_count": 9,
      "nullable_fields": 5
    },
    "processing_requirements": {
      "must_support_partial_deserialization": false,
      "must_support_schema_lookup_by_id": true,
      "must_support_field_projection": "nice_to_have"
    }
  },
  "notes": "This schema represents 95% of event traffic. Remaining 5% are custom event types with similar structure but different field sets."
}