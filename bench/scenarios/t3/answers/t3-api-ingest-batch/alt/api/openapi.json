{
    "components": {
        "schemas": {
            "BatchStatus": {
                "additionalProperties": false,
                "properties": {
                    "results": {
                        "items": {
                            "$ref": "#/components/schemas/ItemResult"
                        },
                        "type": "array"
                    },
                    "deferred": {
                        "minimum": 0,
                        "type": "integer"
                    },
                    "completed": {
                        "minimum": 0,
                        "type": "integer"
                    },
                    "total": {
                        "minimum": 0,
                        "type": "integer"
                    },
                    "state": {
                        "enum": [
                            "processing",
                            "complete",
                            "partial",
                            "failed"
                        ],
                        "type": "string"
                    },
                    "batchId": {
                        "type": "string"
                    }
                },
                "required": [
                    "batchId",
                    "state",
                    "total",
                    "completed",
                    "results"
                ],
                "type": "object"
            },
            "BatchResult": {
                "additionalProperties": false,
                "properties": {
                    "results": {
                        "items": {
                            "$ref": "#/components/schemas/ItemResult"
                        },
                        "type": "array"
                    },
                    "batchId": {
                        "type": "string"
                    }
                },
                "required": [
                    "batchId",
                    "results"
                ],
                "type": "object"
            },
            "ItemResult": {
                "additionalProperties": false,
                "properties": {
                    "reason": {
                        "type": "string"
                    },
                    "status": {
                        "enum": [
                            "accepted",
                            "rejected",
                            "deferred"
                        ],
                        "type": "string"
                    },
                    "readingId": {
                        "type": "string"
                    }
                },
                "required": [
                    "readingId",
                    "status"
                ],
                "type": "object"
            },
            "Reading": {
                "additionalProperties": false,
                "properties": {
                    "unit": {
                        "type": "string"
                    },
                    "value": {
                        "type": "number"
                    },
                    "observedAt": {
                        "format": "date-time",
                        "type": "string"
                    },
                    "deviceId": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "readingId": {
                        "minLength": 1,
                        "type": "string"
                    }
                },
                "required": [
                    "readingId",
                    "deviceId",
                    "observedAt",
                    "value"
                ],
                "type": "object"
            }
        }
    },
    "paths": {
        "/v1/ingest-batches/{batchId}": {
            "get": {
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BatchStatus"
                                }
                            }
                        },
                        "description": "Current aggregate and per-item processing status."
                    },
                    "404": {
                        "description": "The batch is not known."
                    }
                },
                "parameters": [
                    {
                        "schema": {
                            "minLength": 1,
                            "type": "string"
                        },
                        "required": true,
                        "in": "path",
                        "name": "batchId"
                    }
                ],
                "summary": "Get processing status for a submitted batch",
                "operationId": "getIngestBatchStatus"
            }
        },
        "/v1/ingest-batches": {
            "post": {
                "responses": {
                    "207": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BatchResult"
                                }
                            }
                        },
                        "description": "Each submitted reading has an individual outcome."
                    },
                    "400": {
                        "description": "The batch shape or a reading is invalid."
                    },
                    "409": {
                        "description": "The idempotency key is already bound to different input."
                    },
                    "413": {
                        "description": "The request is larger than the gateway limit."
                    },
                    "429": {
                        "description": "The service is applying backpressure."
                    }
                },
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "additionalProperties": false,
                                "properties": {
                                    "readings": {
                                        "items": {
                                            "$ref": "#/components/schemas/Reading"
                                        },
                                        "maxItems": 688,
                                        "minItems": 1,
                                        "type": "array"
                                    }
                                },
                                "required": [
                                    "readings"
                                ],
                                "type": "object"
                            }
                        }
                    },
                    "required": true
                },
                "parameters": [
                    {
                        "schema": {
                            "maxLength": 200,
                            "minLength": 1,
                            "type": "string"
                        },
                        "description": "Stable caller-generated key for safely retrying one batch.",
                        "required": true,
                        "in": "header",
                        "name": "Idempotency-Key"
                    }
                ],
                "summary": "Submit a bounded batch of readings",
                "operationId": "submitReadingBatch"
            }
        }
    },
    "servers": [
        {
            "url": "https://ingest.example.invalid"
        }
    ],
    "info": {
        "description": "Bounded batch ingestion with idempotent retries and item-level outcomes.",
        "version": "1.0.0",
        "title": "Fleet Sensor Ingest API"
    },
    "openapi": "3.1.0"
}
