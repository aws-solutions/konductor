{
  "id": "t5-qa-checkout-strategy",
  "class": "hard",
  "version": 1,
  "phase": "testing",
  "role": "qa",
  "phases2": [
    "security"
  ],
  "questions": "allowed",
  "prompt": "I am starting a checkout rework next sprint and have limited time to test it, so I need a focused QA plan before we touch code. Read the repository, including the source, the existing tests and docs/CHANGELOG.md, then write docs/TEST-PLAN.md: where the real risk is, why it matters, how severe it is, and the specific test to add for each risk, most important first. I would rather have the handful of risks that matter than a tour of every file; skip what is low value to test. End the file with a fenced JSON list of objects with exactly these fields: location (the source file path), severity (critical, high, medium or low) and fix (the test to add). Do not change application source, existing tests, configuration, generated data, CI files or other documentation. The only intended repository change is docs/TEST-PLAN.md.",
  "fixture": "t5-qa-checkout-strategy",
  "hidden": "t5-qa-checkout-strategy",
  "timeoutSec": 1200,
  "limits": {
    "softSec": 600,
    "hardSec": 1200
  },
  "checks": [
    {
      "type": "tests",
      "cmd": "node --test --test-timeout=15000 findings.test.js",
      "min": 17,
      "weight": 3,
      "kind": "substance"
    },
    {
      "type": "file_exists",
      "path": "docs/TEST-PLAN.md",
      "weight": 1,
      "kind": "format"
    },
    {
      "type": "contains",
      "path": "docs/TEST-PLAN.md",
      "pattern": "```json\\s*\\[\\s*\\{\\s*\\\"location\"",
      "weight": 1,
      "kind": "format"
    },
    {
      "type": "min_matches",
      "path": "docs/TEST-PLAN.md",
      "pattern": "\\\"location\\\"\\s*:",
      "min": 8,
      "weight": 3,
      "kind": "substance"
    },
    {
      "type": "fixture_unchanged",
      "path": "src/payments/webhook.js",
      "weight": 1,
      "kind": "substance"
    }
  ],
  "rubric": [
    {
      "id": "prioritization",
      "criterion": "The plan makes a defensible time-based priority choice and explains the customer or operational consequence for the highest risks (code cannot check this because it cannot judge the quality of the reasoning).",
      "weight": 2
    }
  ],
  "findingsKey": [
    {
      "id": "money-floating-point",
      "location": [
        "src/orders/price.js"
      ],
      "severity": "high",
      "fix": [
        "cents",
        "integer",
        "decimal",
        "minor unit",
        "floating"
      ],
      "fixMin": 1,
      "weight": 2
    },
    {
      "id": "webhook-replay",
      "location": [
        "src/payments/webhook.js"
      ],
      "severity": "critical",
      "fix": [
        "idempotency",
        "event id",
        "replay",
        "duplicate"
      ],
      "fixMin": 1,
      "weight": 3
    },
    {
      "id": "inventory-read-write-race",
      "location": [
        "src/inventory/reservation.js"
      ],
      "severity": "critical",
      "fix": [
        "atomic",
        "concurrency",
        "oversell",
        "compare-and-decrement"
      ],
      "fixMin": 1,
      "weight": 3
    },
    {
      "id": "retry-double-charge",
      "location": [
        "src/payments/retry.js"
      ],
      "severity": "critical",
      "fix": [
        "idempotency",
        "status lookup",
        "ambiguous timeout",
        "double-charge",
        "no retry"
      ],
      "fixMin": 1,
      "weight": 3
    },
    {
      "id": "email-swallowed-error",
      "location": [
        "src/notifications/email.js"
      ],
      "severity": "medium",
      "fix": [
        "log",
        "alert",
        "surface",
        "propagate",
        "dead-letter",
        "retry"
      ],
      "fixMin": 1,
      "weight": 1
    },
    {
      "id": "settlement-local-cutoff",
      "location": [
        "src/jobs/settlement.js"
      ],
      "severity": "high",
      "fix": [
        "utc",
        "timezone",
        "time zone",
        "cutoff",
        "midnight"
      ],
      "fixMin": 1,
      "weight": 2
    },
    {
      "id": "refund-rounding",
      "location": [
        "src/orders/refunds.js"
      ],
      "severity": "high",
      "fix": [
        "remainder",
        "allocat",
        "cents",
        "rounding",
        "sum of"
      ],
      "fixMin": 1,
      "weight": 2
    },
    {
      "id": "guard-disabled-by-default",
      "location": [
        "src/orders/checkout.js"
      ],
      "severity": "high",
      "fix": [
        "flag",
        "default",
        "disabled",
        "out-of-stock",
        "oversell"
      ],
      "fixMin": 1,
      "weight": 2
    }
  ],
  "targetSkills": [],
