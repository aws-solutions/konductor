diff --git a/src/webhooks/receiver.js b/src/webhooks/receiver.js
index 095aa77..4cf892b 100644
--- a/src/webhooks/receiver.js
+++ b/src/webhooks/receiver.js
@@ -3,15 +3,62 @@ import { normalizeEvent } from './normalize.js';
 import { validSignature } from './signatures.js';
 import { parseJson } from '../util/json.js';
 
+function headerValue(headers, name) {
+  return headers[name] || headers[name.toLowerCase()] || '';
+}
+
+function envelopeFrom(body, headers) {
+  return {
+    ...body,
+    id: body.id || headerValue(headers, 'x-delivery-id'),
+    kind: eventKind(body.provider || 'source', body)
+  };
+}
+
 export function receiveWebhook({ provider, rawBody, headers, secret, logger }) {
   const parsed = parseJson(rawBody);
   if (parsed.error) return { status: 400, body: { error: 'invalid json' } };
   const body = parsed.value;
-  const provided = headers[`x-${provider}-signature`];
-  if (!validSignature(secret, JSON.stringify(body), provided)) {
-    logger.warn('invalid webhook signature', { signature: provided });
+  const signatureHeader = `x-${provider}-signature`;
+  const provided = headerValue(headers, signatureHeader);
+  const signedText = JSON.stringify(body);
+  const signatureContext = {
+    provider,
+    bodyLength: rawBody.length,
+    headerName: signatureHeader
+  };
+  const signatureValid = validSignature(secret, signedText, provided);
+  if (!signatureValid) {
+    const diagnostic = { ...signatureContext, header: provided };
+    logger.warn('invalid webhook signature', diagnostic);
     return { status: 401, body: { error: 'invalid signature' } };
   }
-  const envelope = { ...body, kind: eventKind(provider, body) };
-  return { status: 202, event: normalizeEvent(provider, envelope) };
+  const envelope = envelopeFrom({ ...body, provider }, headers);
+  const event = normalizeEvent(provider, envelope);
+  return { status: 202, event };
+}
+
+function responseForInvalid(message, status = 400) {
+  return { status, body: { error: message } };
+}
+
+function payloadFor(body) {
+  return body && typeof body === 'object' && !Array.isArray(body) ? body : null;
+}
+
+export function webhookSummary(result) {
+  if (!result.event) return { accepted: false, status: result.status };
+  return {
+    accepted: true,
+    status: result.status,
+    provider: result.event.provider,
+    kind: result.event.kind
+  };
+}
+
+export function validateWebhookShape(rawBody) {
+  const parsed = parseJson(rawBody);
+  if (parsed.error) return responseForInvalid('invalid json');
+  if (!payloadFor(parsed.value)) return responseForInvalid('invalid payload');
+  return { status: 200, body: { valid: true } };
 }
diff --git a/src/webhooks/signatures.js b/src/webhooks/signatures.js
index a021b90..2b5f98b 100644
--- a/src/webhooks/signatures.js
+++ b/src/webhooks/signatures.js
@@ -1,10 +1,34 @@
 import { createHmac } from 'node:crypto';
 
-export function signatureFor(secret, body) {
+function digest(secret, body) {
   return createHmac('sha256', secret).update(body).digest('hex');
 }
 
+export function signatureFor(secret, body) {
+  return `sha256=${digest(secret, body)}`;
+}
+
 export function validSignature(secret, body, provided) {
-  const expected = `sha256=${signatureFor(secret, body)}`;
+  if (typeof provided !== 'string') return false;
+  const expected = signatureFor(secret, body);
   return expected === provided;
 }
+
+export function signatureParts(header) {
+  const [scheme, value] = String(header || '').split('=', 2);
+  return { scheme, value };
+}
+
+export function isSupportedScheme(header) {
+  return signatureParts(header).scheme === 'sha256';
+}
+
+export function hasDigest(header) {
+  const { value } = signatureParts(header);
+  return Boolean(value && /^[a-f0-9]{64}$/i.test(value));
+}
+
+export function describeSignature(header) {
+  const parts = signatureParts(header);
+  return { scheme: parts.scheme || 'unknown', present: Boolean(parts.value) };
+}
