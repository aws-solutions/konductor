{
  "outputFile": "launch/wallet-rollout-plan.md",
  "items": [
    {
      "id": "schema-before-writer",
      "type": "order",
      "path": "steps",
      "first": {
        "field": "action",
        "all": [
          "expan|schema|migrat|column"
        ],
        "none": [
          "writer|mandatory|enforce"
        ]
      },
      "then": {
        "field": "action",
        "all": [
          "writer|write|region_code|mandatory|enforce"
        ],
        "none": [
          "^\\s*(expand|add|create)\\b"
        ]
      }
    },
    {
      "id": "api-before-client",
      "type": "order",
      "path": "steps",
      "first": {
        "field": "action",
        "all": [
          "edge",
          "api|route"
        ]
      },
      "then": {
        "field": "action",
        "all": [
          "client|wallet flag|canary"
        ],
        "none": [
          "edge"
        ]
      }
    },
    {
      "id": "steps-limit",
      "type": "maxLen",
      "path": "steps",
      "max": 14,
      "min": 1
    },
    {
      "id": "traffic-steps-have-gates",
      "type": "none",
      "path": "steps",
      "match": {
        "all": [
          "\"percent\":([1-9]|[1-9][0-9]|100)\\b",
          "\"gate\":null"
        ]
      }
    },
    {
      "id": "no-step-in-freeze",
      "type": "none",
      "path": "steps",
      "match": {
        "field": "start",
        "timeIn": [
          "2026-06-12T18:00:00Z",
          "2026-06-15T06:00:00Z"
        ]
      }
    },
    {
      "id": "gate-metrics-catalogued",
      "type": "inSet",
      "path": "steps",
      "field": "gate.metric",
      "fromFile": "docs/metrics-catalogue.md",
      "pattern": "^\\|\\s*([a-z_]+)\\s*\\|",
      "min": 1
    },
    {
      "id": "rollback-metric-catalogued",
      "type": "inSet",
      "path": "rollback.trigger",
      "field": "metric",
      "fromFile": "docs/metrics-catalogue.md",
      "pattern": "^\\|\\s*([a-z_]+)\\s*\\|",
      "min": 1
    },
    {
      "id": "owners-are-teams",
      "type": "inSet",
      "path": "ownerList",
      "field": "team",
      "fromFile": "team-list.md",
      "pattern": "^\\|\\s*([^|]+?)\\s*\\|",
      "min": 1
    },
    {
      "id": "deciders-are-raci-roles",
      "type": "inSet",
      "path": "goNoGo",
      "field": "decider",
      "fromFile": "raci.md",
      "pattern": "^\\|[^|]*\\|\\s*([^|]+?)\\s*\\|",
      "min": 1
    },
    {
      "id": "no-bank-traffic-before-certification",
      "type": "none",
      "path": "steps",
      "weight": 1,
      "match": {
        "field": "action",
        "all": [
          "solmere"
        ],
        "timeField": "start",
        "timeIn": [
          "2000-01-01T00:00:00Z",
          "2026-06-10T08:59:59Z"
        ]
      }
    },
    {
      "id": "owner-list-is-complete",
      "type": "maxLen",
      "path": "ownerList",
      "min": 1,
      "max": 14
    },
    {
      "id": "go-no-go-list-is-complete",
      "type": "maxLen",
      "path": "goNoGo",
      "min": 4,
      "max": 14
    },
    {
      "id": "canary-share",
      "type": "some",
      "path": "steps",
      "match": {
        "all": [
          "\"percent\":5\\b",
          "canary|client|wallet"
        ]
      },
      "weight": 10
    },
    {
      "id": "noria-full-share",
      "type": "some",
      "path": "steps",
      "match": {
        "all": [
          "noria",
          "\"percent\":100\\b"
        ]
      },
      "weight": 10
    },
    {
      "id": "solmere-full-share",
      "type": "some",
      "path": "steps",
      "match": {
        "all": [
          "solmere",
          "\"percent\":100\\b"
        ]
      },
      "weight": 10
    },
    {
      "id": "kestrel-full-share",
      "type": "some",
      "path": "steps",
      "match": {
        "all": [
          "kestrel",
          "\"percent\":100\\b"
        ]
      },
      "weight": 10
    },
    {
      "id": "veyra-full-share",
      "type": "some",
      "path": "steps",
      "match": {
        "all": [
          "veyra",
          "\"percent\":100\\b"
        ]
      },
      "weight": 10
    },
    {
      "id": "rollback-bake-window",
      "type": "number",
      "path": "rollback.trigger.windowMin",
      "value": 10,
      "tol": 0,
      "weight": 10
    }
  ]
}
