{
  "outputFile": "decisions/0007-deploy-strategy.md",
  "items": [
    {
      "id": "decision-is-canary",
      "type": "text",
      "path": "decision",
      "all": [
        "^\\s*canary( release| deployment| rollout)?\\s*$"
      ],
      "none": [
        "rolling",
        "blue.?green"
      ],
      "weight": 2,
      "section": "decision",
      "gate": true
    },
    {
      "id": "canary-chosen-with-small-exposure",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "canary",
          "\"chosen\""
        ]
      },
      "section": "decision"
    },
    {
      "id": "bluegreen-rejected-for-capacity-cost",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "blue",
          "\"rejected\"",
          "capacity|cost|budget|second fleet|double|7,?200|2,?800|headroom"
        ]
      },
      "weight": 2,
      "section": "decision"
    },
    {
      "id": "rolling-rejected-for-broad-exposure",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "rolling",
          "\"rejected\"",
          "drain|session|websocket|exposure|revert|12 ?min|all hosts|whole fleet|fleet-wide|broad"
        ]
      },
      "section": "decision"
    },
    {
      "id": "constraint-capacity",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "40[- ]?hosts?",
          "72 ?%",
          "capacity-report"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-drain",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "40 ?min",
          "websocket|session|connection",
          "drain",
          "slo"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-schema",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "(two|2) (app(lication)? )?versions|both versions|old and new|mixed versions|n-1|backward",
          "schema|database|migration",
          "schema-compat"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-cost",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "2,?800|7,?200",
          "finance"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-frequency",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "\\b3\\b|three",
          "deploy|release",
          "week",
          "deploy-goals"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-revert-window",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "12 ?min",
          "revert|roll ?back|stop",
          "compliance"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "revisit-capacity-threshold",
      "type": "some",
      "path": "revisitWhen",
      "match": {
        "all": [
          "78 ?%",
          "utili[sz]ation|capacity|spare|headroom"
        ]
      },
      "section": "decision"
    },
    {
      "id": "bounded-constraint-list",
      "type": "maxLen",
      "path": "constraints",
      "min": 5,
      "max": 20,
      "section": "constraints"
    }
  ],
  "scoring": "sections"
}
