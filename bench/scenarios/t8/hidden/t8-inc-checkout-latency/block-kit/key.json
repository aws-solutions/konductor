{
  "outputFile": "incidents/2026-03-checkout-latency.md",
  "items": [
    {
      "id": "cause-summary",
      "type": "text",
      "path": "rootCause.summary",
      "all": [
        "checkout",
        "pool|connection",
        "40.*12|12.*40|reduc|shrink|lower"
      ],
      "none": [
        "receipt|template|garbage.collect|\\bgc\\b"
      ],
      "weight": 1
    },
    {
      "id": "cause-evidence",
      "type": "evidence",
      "path": "rootCause.evidence",
      "groups": [
        {
          "file": "^config/config-diff-week\\.yaml$",
          "all": [
            "services\\.checkout\\.pool_size|after: 12\\s*$|at: 2026-03-17T17:42|source: runtime-config"
          ]
        },
        {
          "file": "^logs/pooler\\.log$",
          "all": [
            "client_pool_size=12",
            "previous=40"
          ]
        },
        {
          "file": "^logs/checkout-api\\.log$",
          "all": [
            "connection_acquire_timeout",
            "status=503"
          ]
        }
      ],
      "min": 2,
      "weight": 1
    },
    {
      "id": "evidence-precision",
      "type": "evidencePrecision",
      "path": "rootCause.evidence",
      "relevant": [
        "services\\.checkout\\.pool_size|after: 12\\s*$|at: 2026-03-17T17:42|source: runtime-config",
        "client_pool_size=12",
        "connection_acquire_timeout",
        "status=503",
        "waiters=[1-9]",
        "pool (exhausted|saturated|full)|configured=12"
      ],
      "min": 0.5,
      "weight": 1
    },
    {
      "id": "timeline-mitigation",
      "type": "some",
      "path": "timeline",
      "match": {
        "all": [
          "restart|last-known-good|roll(ed)? ?back|revert|restor"
        ],
        "timeNear": {
          "time": "2026-03-17T18:41:00Z",
          "tolMin": 2
        }
      },
      "weight": 1
    },
    {
      "id": "timeline-recovery",
      "type": "some",
      "path": "timeline",
      "match": {
        "all": [
          "recover|zero waiters|waiters=0|configured at 40|back to (40|normal)|normal|resolved|restored"
        ],
        "timeNear": {
          "time": "2026-03-17T18:43:00Z",
          "tolMin": 2
        }
      },
      "weight": 1
    },
    {
      "id": "timeline-complete",
      "type": "maxLen",
      "path": "timeline",
      "max": 15,
      "min": 5,
      "weight": 1
    },
    {
      "id": "impact-duration",
