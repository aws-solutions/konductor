{
  "_v7": "Scores the reasoning, not the label. The folder rules blue/green out (second fleet cost against the cap, no spare capacity); canary against rolling it leaves to argument, so a rolling decision passes the gate when blue/green is rejected for cost and canary is rejected for a reason the folder supports. The v4 key gated on canary and scored a reasoned rolling plan 0. Also: the utilisation (72%) and fleet-size (40 hosts) figures may sit in two constraints; the v4 key wanted both in one, which most answers did not do. The 78% revisit item accepts 'CPU' (as the v6 key does).",
  "outputFile": "decisions/0007-deploy-strategy.md",
  "items": [
    {
      "id": "decision-is-not-bluegreen",
      "type": "text",
      "path": "decision",
      "all": [
        "^\\s*(canary( release| deployment| rollout)?|rolling( update| deployment| release| rollout)?)\\s*$"
      ],
      "none": [
        "blue.?green"
      ],
      "weight": 2,
      "section": "decision",
      "gate": true
    },
    {
      "id": "one-option-chosen",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "canary|rolling",
          "\"chosen\""
        ]
      },
      "section": "decision"
    },
    {
      "id": "bluegreen-rejected-for-capacity-cost",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "blue",
          "\"rejected\"",
          "capacity|cost|budget|second fleet|double|7,?200|2,?800|headroom"
        ]
      },
      "weight": 2,
      "section": "decision"
    },
    {
      "id": "other-option-rejected-with-folder-reason",
      "type": "some",
      "path": "options",
      "match": {
        "all": [
          "canary|rolling",
          "\"rejected\"",
          "drain|session|websocket|exposure|revert|12 ?min|all hosts|whole fleet|fleet-wide|broad|720|slice|rout(er|ing)|traffic split|weighted|dilut|signal|alert|metric|first (batch|wave|stage)|small(er)? batch|tooling|duplicat|redundant|extra stage|added stage|additional stage|same protection"
        ]
      },
      "section": "decision"
    },
    {
      "id": "constraint-capacity",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "72 ?%",
          "utili[sz]ation|\\bCPU\\b|capacity|spare|ceiling|headroom",
          "capacity-report"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-fleet-size",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "40[- ]?hosts?",
          "capacity-report|hosts\\.json"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-drain",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "40 ?min",
          "websocket|session|connection",
          "drain",
          "slo"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-schema",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "(two|2) (app(lication)? )?versions|both versions|old and new|mixed versions|n-1|backward",
          "schema|database|migration",
          "schema-compat"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-cost",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "2,?800|7,?200",
          "finance"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-frequency",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "\\b3\\b|three",
          "deploy|release",
          "week",
          "deploy-goals"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "constraint-revert-window",
      "type": "some",
      "path": "constraints",
      "match": {
        "all": [
          "12 ?min",
          "revert|roll ?back|stop",
          "compliance"
        ]
      },
      "section": "constraints"
    },
    {
      "id": "revisit-capacity-threshold",
      "type": "some",
      "path": "revisitWhen",
      "match": {
        "all": [
          "78 ?%",
          "utili[sz]ation|capacity|spare|headroom|\\bCPU\\b"
        ]
      },
      "section": "decision"
    },
    {
      "id": "bounded-constraint-list",
      "type": "maxLen",
      "path": "constraints",
      "min": 5,
      "max": 20,
      "section": "constraints"
    }
  ],
  "scoring": "sections"
}
