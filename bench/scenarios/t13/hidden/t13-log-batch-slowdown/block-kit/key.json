{
  "outputFile": "analysis/nightly-report-slowdown.md",
  "items": [
    {
      "id": "first-slow-night",
      "type": "text",
      "path": "firstSlowNight",
      "all": [
        "2026-04-0[34]"
      ],
      "weight": 2
    },
    {
      "id": "slow-stage",
      "type": "text",
      "path": "slowStage",
      "all": [
        "enrich"
      ],
      "weight": 2
    },
    {
      "id": "cause-names-parallelism-cut",
      "type": "text",
      "path": "cause.summary",
      "all": [
        "parallel|workers?|concurrency|thread",
        "8\\s*(?:->|to|→)\\s*2|from 8|8 .{0,20}2|two workers|2 workers"
      ],
      "none": [
        "(?:caused by|due to|because of|driven by).{0,60}(?:volume|data growth|input growth)"
      ],
      "weight": 2
    },
    {
      "id": "cause-history-evidence",
      "type": "evidence",
      "path": "cause.evidence",
      "groups": [
        {
          "file": "config/history\\.md",
          "all": [
            "2026-04-03",
            "enrich\\.parallelism",
            "8",
            "2"
          ]
        }
      ],
      "min": 1,
      "weight": 2
    },
    {
      "id": "growth-minutes",
      "type": "number",
      "path": "growthMinutesPerNight",
      "value": 11,
      "tol": 2,
      "weight": 2
    },
    {
      "id": "excluded-publish-outlier",
      "type": "some",
      "path": "excludedNights",
      "match": {
        "all": [
          "2026-04-09",
          "publish|retr"
        ]
      },
      "weight": 3
    },
    {
      "id": "excluded-list-is-focused",
