{
  "outputFile": "triage/4.2.0-crash-triage.md",
  "items": [
    {
      "id": "defect-count-bounded",
      "type": "maxLen",
      "path": "defects",
      "min": 3,
      "max": 5,
      "weight": 2
    },
    {
      "id": "sync-group-present",
      "type": "some",
      "path": "defects",
      "match": {
        "field": "signature",
        "all": [
          "SyncRoot|resolve|root\\.cpp"
        ]
      },
      "weight": 1
    },
    {
      "id": "sync-report-count",
      "type": "some",
      "path": "defects",
      "match": {
        "field": "reports",
        "num": {
          "gte": 153,
          "lte": 187
        }
      },
      "weight": 2
    },
    {
      "id": "sync-user-count",
      "type": "some",
      "path": "defects",
      "match": {
        "field": "users",
        "num": {
          "gte": 108,
          "lte": 132
        }
      },
      "weight": 2
    },
    {
      "id": "sync-hotfix",
      "type": "some",
      "path": "defects",
      "match": {
        "all": [
          "SyncRoot|resolve",
          "hotfix"
        ]
      },
      "weight": 2
    },
    {
      "id": "sync-suspect",
      "type": "some",
      "path": "defects",
      "match": {
        "field": "suspectChange",
        "all": [
          "root\\.cpp|SyncRoot|removable|resolve"
        ]
      },
      "weight": 2
    },
    {
      "id": "no-split-inline-variant",
      "type": "none",
      "path": "defects",
      "match": {
        "field": "signature",
        "all": [
          "resolveImpl"
        ],
        "none": [
          "SyncRoot::resolve\\b|merged|same defect|one defect|variant|inlin"
        ]
      },
      "weight": 1
    },
    {
      "id": "tray-not-regression",
      "type": "some",
      "path": "defects",
      "match": {
        "all": [
          "tray|TrayIcon",
          "\\\"regression\\\"\\s*:\\s*false"
        ]
      },
      "weight": 1
    },
    {
      "id": "database-user-count",
      "type": "some",
      "path": "defects",
      "match": {
        "field": "users",
        "num": {
          "gte": 2,
          "lte": 4
        }
      },
      "weight": 2
    },
    {
      "id": "thumbnail-hotfix",
      "type": "some",
      "path": "defects",
      "match": {
        "all": [
          "thumbnail|OutOfMemory|OOM",
          "hotfix"
        ]
      },
      "weight": 3
    },
    {
      "id": "no-scheduler-suspect",
      "type": "none",
      "path": "defects",
      "match": {
        "field": "suspectChange",
        "all": [
          "scheduler"
        ],
        "none": [
          "not|ruled out|decoy|no\\b|unrelated"
        ]
      },
      "weight": 1
    },
    {
      "id": "beta-excluded",
      "type": "text",
      "path": "excluded",
      "all": [
        "beta|3\\.9\\.0-beta2"
      ]
    },
    {
      "id": "no-beta-sample",
      "type": "none",
      "path": "defects",
      "match": {
        "field": "sampleReports",
        "all": [
          "crash-029[1-9]|crash-0300"
        ],
        "none": [
          "excluded|beta|set aside"
        ]
      }
    },
    {
      "id": "evidence-covers-three-facts",
      "type": "evidence",
      "path": "evidence",
      "groups": [
        {
          "file": "release/4\\.2\\.0-diff\\.txt",
          "all": [
            "normalizePath|isRemovable"
          ]
        },
        {
          "file": "crashes/crash-0216\\.json",
          "all": [
            "4\\.1\\.3",
            "TrayIcon"
          ]
        },
        {
          "file": "ops/logs/desktop-sync\\.log",
          "all": [
            "dropping pending|pending uploads"
          ]
        }
      ],
      "min": 3,
      "weight": 2
    },
    {
      "id": "evidence-is-precise",
      "type": "evidencePrecision",
      "path": "evidence",
      "relevant": [
        "normalizePath|isRemovable|4\\.1\\.3|TrayIcon|dropping pending|pending uploads"
      ],
      "min": 0.6,
      "weight": 1
    },
    {
      "id": "asked-weekly-active-users",
      "type": "text",
      "path": "method",
      "all": [
        "9,?000|9k|nine thousand",
        "active users|WAU|1 ?%|one percent"
      ]
    },
    {
      "id": "asked-platform-hotfix-rule",
      "type": "text",
      "path": "method",
      "all": [
        "all platforms|every platform|together|cross-platform|not .* (one|single) platform",
        "hotfix"
      ]
    },
    {
      "id": "asked-feature-flag",
      "type": "text",
      "path": "method",
      "all": [
        "flag|kill switch|toggle|disable",
        "removable[- ]drive|removable drive"
      ]
    }
  ]
}
