{
  "output": "release/go-no-go.md",
  "block": "release-decision",
  "assertions": [
    {
      "id": "decision",
      "desc": "the release decision is no-go when unresolved release evidence remains",
      "op": "equals",
      "path": "decision",
      "value": "no-go"
    },
    {
      "id": "blocker-rel-131",
      "desc": "the blockers list cites REL-131",
      "op": "cites",
      "path": "blockers",
      "field": "tickets",
      "ids": [
        "REL-131"
      ]
    },
    {
      "id": "owner-rel-118",
      "desc": "the blocker entry for REL-118 names its owner",
      "op": "cites",
      "path": "blockers",
      "field": "tickets",
      "ids": [
        "REL-118"
      ],
      "where": {
        "owner": "Jon Bell"
      }
    },
    {
      "id": "owner-rel-131",
      "desc": "the blocker entry for REL-131 names its owner",
      "op": "cites",
      "path": "blockers",
      "field": "tickets",
      "ids": [
        "REL-131"
      ],
      "where": {
        "owner": "Asha Nair"
      }
    },
    {
      "id": "earliest-slot",
      "desc": "the earliest defensible release slot is reported",
      "op": "date",
      "path": "earliest_release_date",
      "value": "2027-05-13",
      "tolDays": 0
    },
    {
      "id": "complete-blocker-set",
      "desc": "all actionable blocker tickets are carried into the blocker list",
      "op": "includes",
      "path": "blockers",
      "ids": [
        "REL-112",
        "REL-118",
        "REL-131"
      ]
    },
    {
      "id": "only-late-approved-pick",
      "desc": "the late-approved list contains only the late approved cherry-pick",
      "op": "precision",
      "path": "late_cherry_picks",
      "field": null,
      "ids": [
        "REL-118"
      ],
      "min": 1,
      "maxCount": 1
    },
    {
      "id": "notes-match-branch",
      "desc": "every notes correction names a claim that is not on the release branch (reverted REL-127, or REL-112 and REL-104 whose commits are not on release/27.05)",
      "op": "precision",
      "path": "notes_corrections",
      "field": null,
      "ids": [
        "REL-127",
        "REL-112",
        "REL-104"
      ],
      "min": 1,
      "maxCount": 3
    },
    {
      "id": "notes-branch-claims",
      "desc": "the notes corrections also catch a claim whose commit is not on the release branch (REL-112 or REL-104)",
      "op": "includes",
      "path": "notes_corrections",
      "ids": [
        "REL-112",
        "REL-104"
      ],
      "any": true
    },
    {
      "id": "third-blocker-present",
      "desc": "the blocker list keeps a third actionable entry",
      "op": "equals",
      "path": "blockers.2.owner",
      "oneOf": [
        "Mira Sol",
        "Jon Bell",
        "Asha Nair"
      ]
    },
    {
      "id": "third-blocker-ticket",
      "desc": "the third blocker entry carries an actionable ticket",
      "op": "equals",
      "path": "blockers.2.tickets.0",
      "oneOf": [
        "REL-112",
        "REL-118",
        "REL-131"
      ]
    },
    {
      "id": "late-decoy-145-absent",
      "desc": "a timely demoted issue is not called a late cherry-pick",
      "op": "absent",
      "path": "late_cherry_picks",
      "field": null,
      "ids": [
        "REL-145"
      ]
    },
    {
      "id": "late-decoy-153-absent",
      "desc": "a cancelled queue item is not called a late cherry-pick",
      "op": "absent",
      "path": "late_cherry_picks",
      "field": null,
      "ids": [
        "REL-153"
      ]
    },
    {
      "id": "notes-decoy-145-absent",
      "desc": "a demoted issue is not marked for release-note correction",
      "op": "absent",
      "path": "notes_corrections",
      "field": null,
      "ids": [
        "REL-145"
      ]
    },
    {
      "id": "notes-decoy-153-absent",
      "desc": "a cancelled queue item is not marked for release-note correction",
      "op": "absent",
      "path": "notes_corrections",
      "field": null,
      "ids": [
        "REL-153"
      ]
    }
  ]
}
