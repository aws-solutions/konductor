      "field": "tickets",
      "ids": [
        "REL-118"
      ]
    },
    {
      "id": "blocker-rel-131",
      "desc": "the blockers list cites REL-131",
      "op": "cites",
      "path": "blockers",
      "field": "tickets",
      "ids": [
        "REL-131"
      ]
    },
    {
      "id": "owner-rel-112",
