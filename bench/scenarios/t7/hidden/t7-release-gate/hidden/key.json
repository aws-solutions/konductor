{
  "output": "release/go-no-go.md",
  "block": "release-decision",
  "assertions": [
    {
      "id": "decision",
      "desc": "the release decision is no-go when unresolved release evidence remains",
      "op": "equals",
      "path": "decision",
      "value": "no-go"
    },
    {
      "id": "blocker-precision",
      "desc": "the blockers list is focused on the derived actionable tickets",
      "op": "precision",
      "path": "blockers",
      "field": "tickets",
      "ids": [
        "REL-112",
        "REL-118",
        "REL-131"
      ],
      "min": 0.5,
      "maxCount": 6
    },
    {
      "id": "blocker-rel-112",
      "desc": "the blockers list cites REL-112",
      "op": "cites",
      "path": "blockers",
      "field": "tickets",
